import requests
import re
from typing import List, Dict

class JoobleParser:
    BASE_URL = "https://jooble.org/api/"
    
    def __init__(self, api_key: str):
        self.api_key = api_key
    
    def search(self, keywords: str, location: str = "Россия", salary_from: int = 100000, period: int = 3, per_page: int = 50, page: int = 0) -> List[Dict]:
        payload = {
            "keywords": keywords,
            "location": location,
            "salary": salary_from,
            "period": period,
            "page": page
        }
        headers = {'content-type': 'application/json'}
        
        try:
            response = requests.post(
                self.BASE_URL + self.api_key,
                json=payload,
                headers=headers,
                timeout=15
            )
            response.raise_for_status()
            data = response.json()
            return data.get('jobs', [])
        except Exception as e:
            print(f"Ошибка при запросе к Jooble: {e}")
            return []
    
    def parse_vacancy(self, job: Dict) -> Dict:
        salary = job.get('salary')
        salary_parsed = self._parse_salary(salary) if salary else {}
        
        return {
            'id': job.get('id', ''),
            'title': job.get('title', 'Без названия'),
            'company': job.get('company', 'Неизвестная компания'),
            'salary': salary_parsed,
            'salary_from': salary_parsed.get('from'),
            'salary_to': salary_parsed.get('to'),
            'description': job.get('snippet', '') or job.get('description', ''),
            'url': job.get('link', '#'),
            'source': 'jooble',
            'area': {'name': job.get('location', 'Не указан')},
            'published_at': job.get('updated', ''),
            'skills': []
        }
    
    def _parse_salary(self, salary_text: str) -> Dict:
        salary_data = {}
        if not salary_text:
            return salary_data
        
        numbers = re.findall(r'(\d{1,3}(?:[ \d]{3})*)', salary_text)
        if numbers:
            nums = [int(n.replace(' ', '')) for n in numbers]
            if len(nums) == 1:
                salary_data['from'] = nums[0]
            elif len(nums) >= 2:
                salary_data['from'] = nums[0]
                salary_data['to'] = nums[1]
        
        if '₽' in salary_text or 'руб' in salary_text:
            salary_data['currency'] = 'руб'
        elif '$' in salary_text:
            salary_data['currency'] = 'USD'
        elif '€' in salary_text:
            salary_data['currency'] = 'EUR'
        else:
            salary_data['currency'] = 'руб'
        
        return salary_data