import sqlite3
from typing import List

DB_PATH = "vacancies.db"

def init_db():
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute('''
        CREATE TABLE IF NOT EXISTS users (
            user_id INTEGER PRIMARY KEY,
            is_subscribed INTEGER DEFAULT 1,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    ''')
    c.execute('''
        CREATE TABLE IF NOT EXISTS applied (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER NOT NULL,
            vacancy_id TEXT NOT NULL,
            source TEXT NOT NULL DEFAULT 'jooble',
            applied_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    ''')
    c.execute('''
        CREATE TABLE IF NOT EXISTS sent_notifications (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER NOT NULL,
            vacancy_id TEXT NOT NULL,
            sent_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    ''')
    c.execute('CREATE INDEX IF NOT EXISTS idx_applied_user_vacancy ON applied(user_id, vacancy_id)')
    c.execute('CREATE INDEX IF NOT EXISTS idx_sent_user_vacancy ON sent_notifications(user_id, vacancy_id)')
    conn.commit()
    conn.close()

def add_applied(user_id: int, vacancy_id: str, source: str = 'jooble'):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute('INSERT OR IGNORE INTO applied (user_id, vacancy_id, source) VALUES (?, ?, ?)',
              (user_id, vacancy_id, source))
    conn.commit()
    conn.close()

def get_applied_ids(user_id: int) -> List[str]:
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute('SELECT vacancy_id FROM applied WHERE user_id = ?', (user_id,))
    rows = c.fetchall()
    conn.close()
    return [row[0] for row in rows]

def add_sent_notification(user_id: int, vacancy_id: str):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute('INSERT OR IGNORE INTO sent_notifications (user_id, vacancy_id) VALUES (?, ?)',
              (user_id, vacancy_id))
    conn.commit()
    conn.close()

def get_sent_ids(user_id: int) -> List[str]:
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute('SELECT vacancy_id FROM sent_notifications WHERE user_id = ?', (user_id,))
    rows = c.fetchall()
    conn.close()
    return [row[0] for row in rows]

def get_all_users() -> List[int]:
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute('SELECT user_id FROM users WHERE is_subscribed = 1')
    rows = c.fetchall()
    conn.close()
    return [row[0] for row in rows]

def subscribe_user(user_id: int):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute('INSERT OR IGNORE INTO users (user_id, is_subscribed) VALUES (?, 1)', (user_id,))
    conn.commit()
    conn.close()