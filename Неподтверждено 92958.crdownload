import logging
import re
from telegram import Update
from telegram.ext import Application, CommandHandler, ContextTypes
from config import BOT_TOKEN, JOOBLE_API_KEY
from jooble_parser import JoobleParser
from criteria import (
    PROFESSIONS, SKILLS, CITIES, DESIRED_SALARY, MIN_SALARY,
    NEAR_CITIES, REMOTE_KEYWORDS, ENGLISH_PHRASES
)
from database import init_db, add_applied, get_applied_ids, subscribe_user
from scheduler import start_scheduler
from bot_helpers import format_vacancy_message

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

jooble = JoobleParser(JOOBLE_API_KEY)

# ---- Команды ----
async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    subscribe_user(user_id)
    await update.message.reply_text(
        "👋 Привет, Алексей!\n\n"
        "Я бот для поиска работы по **всему интернету**.\n"
        "Критерии поиска уже настроены под ваше резюме.\n\n"
        "🔍 /search – найти вакансии\n"
        "📌 /apply <номер> – отметить, что откликнулись на вакансию из списка\n"
        "📥 /import_applied <список ID> – импортировать уже откликнутые вакансии\n\n"
        f"💰 Зарплата от {MIN_SALARY} ₽ (и не менее 80% от {DESIRED_SALARY} ₽).\n"
        "📌 Для СПб и области (радиус 200 км) – только удалёнка.\n"
        "✅ Откликнутые вакансии больше не показываются.\n"
        "🚫 Исключаю вакансии на английском языке."
    )

async def search(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    subscribe_user(user_id)
    
    professions_with_tilde = [f'~{p}' for p in PROFESSIONS]
    keywords = ' OR '.join(professions_with_tilde)
    if SKILLS:
        keywords += ' ' + ' '.join(SKILLS[:5])
    
    await update.message.reply_text(
        f"🔍 Ищу вакансии для: {', '.join(PROFESSIONS[:5])} и похожих...\n"
        f"Фильтрую по навыкам: {', '.join(SKILLS[:5])}\n"
        f"{'Учитываю города для переезда: ' + ', '.join(CITIES[:5]) if CITIES else 'Ищем во всех городах'}\n"
        "📌 Для СПб и области (радиус 200 км) – только удалёнка.\n"
        f"💰 Зарплата от {MIN_SALARY} ₽ (и не менее 80% от {DESIRED_SALARY} ₽).\n"
        "🚫 Исключаем вакансии на английском языке."
    )
    
    try:
        items = jooble.search(keywords, location="Россия", salary_from=MIN_SALARY, period=3, per_page=50)
        if not items:
            await update.message.reply_text("😕 По вашему запросу ничего не найдено.")
            return
        
        parsed = [jooble.parse_vacancy(job) for job in items]
        filtered = filter_vacancies(parsed, user_id)
        
        if not filtered:
            await update.message.reply_text(
                "😕 Подходящих вакансий не найдено.\n"
                "Попробуйте позже или измените критерии в файле criteria.py."
            )
            return
        
        filtered.sort(key=lambda x: x.get('published_at', ''), reverse=True)
        context.user_data['last_search_vacancies'] = filtered  # для /apply
        
        msg = f"✅ Найдено подходящих вакансий: {len(filtered)}\n\n"
        count = 0
        for i, vac in enumerate(filtered[:20], 1):
            msg += f"{i}. {format_vacancy_message(vac)}\n\n"
        msg += "\nЧтобы отметить отклик, отправьте номер вакансии: /apply <номер>"
        
        await update.message.reply_text(msg, parse_mode='Markdown', disable_web_page_preview=True)
        
    except Exception as e:
        logger.error(f"Ошибка при поиске: {e}")
        await update.message.reply_text("Произошла ошибка. Попробуйте позже.")

async def apply(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    args = context.args
    if not args:
        await update.message.reply_text("Укажите номер вакансии из последнего поиска, например: /apply 3")
        return
    try:
        index = int(args[0]) - 1
        vacancies = context.user_data.get('last_search_vacancies', [])
        if index < 0 or index >= len(vacancies):
            await update.message.reply_text("Неверный номер. Используйте номер из списка.")
            return
        vac = vacancies[index]
        add_applied(user_id, vac['id'], source='jooble')
        await update.message.reply_text(f"✅ Отклик на вакансию «{vac['title']}» отмечен! Она больше не будет показываться.")
    except (ValueError, IndexError):
        await update.message.reply_text("Ошибка: укажите номер цифрой, например: /apply 3")

async def import_applied(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    text = update.message.text
    if text.startswith('/import_applied'):
        ids_str = text.replace('/import_applied', '').strip()
    else:
        ids_str = text.strip()
    if not ids_str:
        await update.message.reply_text("Отправьте список ID вакансий через запятую или пробел.\nПример: /import_applied 123456, 789012, 345678")
        return
    ids = re.findall(r'\d+', ids_str)
    if not ids:
        await update.message.reply_text("Не найдено чисел. Отправьте ID цифрами.")
        return
    count = 0
    for vid in ids:
        add_applied(user_id, vid, source='import')
        count += 1
    await update.message.reply_text(f"✅ Импортировано {count} вакансий. Они больше не будут показываться.")

# ---- Фильтры ----
def filter_vacancies(vacancies, user_id):
    # 1. По навыкам (минимум 2)
    filtered = []
    for vac in vacancies:
        full_text = (vac.get('title', '') + ' ' + vac.get('description', '')).lower()
        match_count = sum(1 for skill in SKILLS if skill in full_text)
        if match_count >= 2:
            filtered.append(vac)
    
    # 2. По городам
    if CITIES:
        filtered = [v for v in filtered if any(city in v.get('area', {}).get('name', '').lower() for city in CITIES)]
    
    # 3. Удалёнка для ближних городов
    filtered = [
        v for v in filtered
        if not any(city in v.get('area', {}).get('name', '').lower() for city in NEAR_CITIES)
        or any(kw in (v.get('title','')+' '+v.get('description','')).lower() for kw in REMOTE_KEYWORDS)
    ]
    
    # 4. Исключаем откликнутые
    applied_ids = get_applied_ids(user_id)
    if applied_ids:
        filtered = [v for v in filtered if v.get('id') not in applied_ids]
    
    # 5. Исключаем английский
    filtered = [
        v for v in filtered
        if not any(phrase in (v.get('title','')+' '+v.get('description','')).lower() for phrase in ENGLISH_PHRASES)
    ]
    
    # 6. Зарплата
    if DESIRED_SALARY:
        filtered = [
            v for v in filtered
            if v.get('salary_from') and v['salary_from'] >= MIN_SALARY and v['salary_from'] >= DESIRED_SALARY * 0.8
        ]
    else:
        filtered = [v for v in filtered if v.get('salary_from') and v['salary_from'] >= MIN_SALARY]
    
    return filtered

# ---- Запуск ----
def main():
    init_db()
    start_scheduler()
    app = Application.builder().token(BOT_TOKEN).build()
    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("search", search))
    app.add_handler(CommandHandler("apply", apply))
    app.add_handler(CommandHandler("import_applied", import_applied))
    print("🤖 Бот запущен с предустановленными критериями.")
    print("📡 Поиск через Jooble по всему интернету.")
    print("⏰ Автоматический поиск новых вакансий каждый час.")
    app.run_polling()

if __name__ == '__main__':
    main()