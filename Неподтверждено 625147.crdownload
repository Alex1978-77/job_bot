import logging
from apscheduler.schedulers.background import BackgroundScheduler
from apscheduler.triggers.interval import IntervalTrigger
from telegram import Bot
from config import BOT_TOKEN, JOOBLE_API_KEY
from jooble_parser import JoobleParser
from database import get_all_users, get_sent_ids, add_sent_notification
from criteria import (
    PROFESSIONS, SKILLS, MIN_SALARY, DESIRED_SALARY,
    NEAR_CITIES, REMOTE_KEYWORDS, ENGLISH_PHRASES, CITIES
)
from bot_helpers import format_vacancy_message
from bot import filter_vacancies  # импортируем функцию из bot.py

logger = logging.getLogger(__name__)
bot = Bot(token=BOT_TOKEN)
jooble = JoobleParser(JOOBLE_API_KEY)

def start_scheduler():
    scheduler = BackgroundScheduler()
    scheduler.add_job(
        func=auto_search,
        trigger=IntervalTrigger(hours=1),
        id='auto_search_job',
        replace_existing=True
    )
    scheduler.start()
    logger.info("Планировщик запущен (поиск каждый час)")

def auto_search():
    logger.info("Запуск автоматического поиска...")
    users = get_all_users()
    if not users:
        logger.info("Нет пользователей с подпиской.")
        return
    for user_id in users:
        try:
            send_new_vacancies(user_id)
        except Exception as e:
            logger.error(f"Ошибка для пользователя {user_id}: {e}")

def send_new_vacancies(user_id: int):
    professions_with_tilde = [f'~{p}' for p in PROFESSIONS]
    keywords = ' OR '.join(professions_with_tilde)
    if SKILLS:
        keywords += ' ' + ' '.join(SKILLS[:5])
    
    items = jooble.search(keywords, location="Россия", salary_from=MIN_SALARY, period=1, per_page=50)
    if not items:
        return
    
    parsed = [jooble.parse_vacancy(job) for job in items]
    from bot import filter_vacancies
    filtered = filter_vacancies(parsed, user_id)
    
    sent_ids = get_sent_ids(user_id)
    new_vacancies = [v for v in filtered if v['id'] not in sent_ids]
    
    if not new_vacancies:
        return
    
    for vac in new_vacancies:
        msg = format_vacancy_message(vac)
        try:
            bot.send_message(chat_id=user_id, text=msg, parse_mode='Markdown', disable_web_page_preview=True)
            add_sent_notification(user_id, vac['id'])
            logger.info(f"Отправлено уведомление пользователю {user_id}: {vac['title']}")
        except Exception as e:
            logger.error(f"Не удалось отправить уведомление пользователю {user_id}: {e}")